{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@karakeep/root",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "db:generate": "pnpm --filter @karakeep/db run generate",
    "db:migrate": "pnpm --filter @karakeep/db run migrate",
    "db:migrate:queue": "pnpm --filter @karakeep/workers run migrate:queue",
    "db:studio": "pnpm --filter @karakeep/db studio",
    "seed:apply": "pnpm --filter @karakeep/seed-snapshot run apply",
    "seed:snapshot": "pnpm --filter @karakeep/seed-snapshot run snapshot",
    "workers": "pnpm --filter @karakeep/workers run start",
    "web": "pnpm --filter @karakeep/web run dev",
    "web:portless": "pnpm --filter @karakeep/web run dev:portless",
    "dev:worktree": "bash scripts/dev-worktree.sh",
    "android": "pnpm --filter @karakeep/mobile android",
    "ios": "pnpm --filter @karakeep/mobile ios",
    "prepare": "husky",
    "format": "turbo format --continue",
    "format:fix": "turbo format:fix --continue",
    "lint": "turbo lint --continue",
    "lint:fix": "turbo lint:fix --continue",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "preflight": "turbo run typecheck lint format",
    "preflight:fix": "turbo run typecheck lint:fix format:fix",
    "test:auth": "node scripts/e2e-auth.mjs",
    "test:e2e:web": "node scripts/e2e-web.mjs",
    "desktop:dev": "electron apps/desktop",
    "desktop:pack": "npm --prefix apps/desktop run pack",
    "test:capture": "node scripts/e2e-capture.mjs",
    "test:ie": "node scripts/e2e-import-export.mjs",
    "test:pwa": "node scripts/e2e-pwa.mjs",
    "test:ext": "node scripts/e2e-extension.mjs",
    "test:ai": "node scripts/e2e-ai-mock.mjs",
    "test:backup": "node scripts/e2e-backup.mjs",
    "test:pdf": "tsx scripts/e2e-pdf-ocr.mts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "husky": "^9.0.11",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "sherif": "^1.6.1",
    "turbo": "^2.10.13"
  },
  "packageManager": "pnpm@11.28.9"
}
