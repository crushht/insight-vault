# ============================================================
# 灵感仓 INSIGHT VAULT · 环境配置
#
# 用法：复制成 .env 放在仓库根目录（apps/web 与 apps/workers 也各需要一份）
#   cp .env.sample .env
#
# 带 [必填] 的不填就跑不起来；其余留空即可，功能会降级但不会崩。
# ============================================================

# ---------- 1. 基础 [必填] ----------

# 数据目录：数据库、附件、日志都在这里
# Windows 示例：E:/fork/2/insight-vault/.data
DATA_DIR=<path>

# 会话加密密钥，随便生成一串长随机字符串
#   openssl rand -base64 36
#   powershell: node -e "console.log(require('crypto').randomBytes(36).toString('base64'))"
NEXTAUTH_SECRET=<secret>

# 对外访问地址（影响邮件链接、OAuth 回调）
NEXTAUTH_URL=http://localhost:3000

# ---------- 2. AI 模型 [二选一，不填则 AI 功能不可用] ----------
#
# 本产品不内置模型。下面两种接法任选其一：
#
#   A) OpenAI 兼容接口（OpenAI / DeepSeek / 通义 / 自建中转 / vLLM 都行）
#   B) 本地 Ollama
#
# 注意：一旦设置了 OPENAI_API_KEY，Ollama 通道会被忽略。

# --- A. OpenAI 兼容 ---
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# 也可以用国内兼容服务，例如：
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 文本模型（打标签、摘要、对话、专题、创作都用它）
#   gpt-4o-mini / deepseek-chat / qwen-plus / glm-4-flash …
# INFERENCE_TEXT_MODEL=gpt-4o-mini

# 视觉模型（图片 OCR / 描述，可选）
# INFERENCE_IMAGE_MODEL=gpt-4o-mini

# --- B. 本地 Ollama ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_KEEP_ALIVE=5m
# INFERENCE_TEXT_MODEL=qwen2.5:7b

# --- 向量检索（可选）---
# 配了才会做语义检索；不配时搜索与 AI 检索降级为关键词匹配
# EMBEDDING_OPENAI_API_KEY=sk-xxxxxxxx
# EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1
# EMBEDDING_TEXT_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ---------- 3. 搜索（可选，强烈建议） ----------
#
# 不配 Meilisearch 时：搜索走 SQL LIKE（能用，但没有相关度排序与高亮）
# MEILI_ADDR=http://127.0.0.1:7700
# MEILI_MASTER_KEY=<key>

# ---------- 4. 抓取（可选） ----------
#
# 不配浏览器时用纯 HTTP 抓取（拿不到 JS 渲染的页面、没有截图）
# BROWSER_WEB_URL=http://127.0.0.1:9222
# BROWSER_CONNECT_ONDEMAND=false

# 需要登录才能看的站点，导入浏览器 Cookie（Netscape 格式）
# BROWSER_COOKIE_PATH=<path>

# ---------- 5. 行为开关 ----------

# 限流（默认开）。本地调试想连跑脚本时可临时关掉
# RATE_LIMITING_ENABLED=false

# 是否自动给新收藏打标签 / 生成摘要（默认开）
# INFERENCE_ENABLE_AUTO_TAGGING=true
# INFERENCE_ENABLE_AUTO_SUMMARIZATION=true

# 是否开启注册（默认开）。只给自己用时建议关闭并手动建号
# DISABLE_SIGNUPS=true

# ---------- 6. 其它 ----------

# 访问日志级别：debug / info / warn / error
# LOG_LEVEL=info

# 时区（影响定时任务与展示）
# TZ=Asia/Shanghai

# ---------- 7. 邮件（可选，用于邮箱验证码登录 / 找回密码） ----------
#
# 不填就没有「邮箱验证码」登录入口，密码登录照常可用。
# 注意 SMTP_PASSWORD 填的是**授权码**，不是邮箱登录密码
#   QQ 邮箱：设置 → 账户 → 开启 SMTP → 生成授权码
#   163 邮箱：设置 → POP3/SMTP/IMAP → 开启 → 生成授权码
#
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@qq.com
# SMTP_PASSWORD=<授权码>
# SMTP_FROM="灵感仓 <you@qq.com>"
